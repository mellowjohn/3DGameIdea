# Shared password for collaborators (set in Vercel project env, never commit real values)
SITE_PASSWORD=change-me-to-a-strong-shared-password

# Optional second secret for cookie signing. Falls back to SITE_PASSWORD when unset.
SESSION_SECRET=

# Durable comments (Upstash Redis REST). Free tier is enough for collab feedback.
# Create a DB at https://console.upstash.com (or claim a start-redis console URL),
# then set both vars on Vercel Production/Preview.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
